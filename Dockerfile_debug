ARG MAKE_JOBS="1"
ARG DEBIAN_FRONTEND="noninteractive"

FROM debian:bookworm-slim AS base
FROM buildpack-deps:bookworm AS base-builder

FROM base-builder AS mrtrix3-builder

# Git commitish from which to build MRtrix3.
# This is branch "dev" as at 2026-06-22
ARG MRTRIX3_GIT_COMMITISH="b98b54e9ae8168eeb9af23322a07011d4754456d"

RUN apt-get -qq update \
    && apt-get install -yq --no-install-recommends \
        cmake \
        libfftw3-dev \
        ninja-build \
        pkg-config \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone the version of MRtrix3 required
ARG MAKE_JOBS
WORKDIR /src/mrtrix3
RUN git clone https://github.com/MRtrix3/mrtrix3.git . \
    && git checkout $MRTRIX3_GIT_COMMITISH

# As support for external modules compiling against cmake MRtrix3 is not yet committed,
#   just insert the code for this tool into the MRtrix3 directory
#   prior to cmake configuration
COPY cpp/cmd/dwidenoise2.cpp /src/mrtrix3/cpp/cmd/dwidenoise2.cpp
COPY cpp/cmd/dwi2noise.cpp /src/mrtrix3/cpp/cmd/dwi2noise.cpp
COPY cpp/core/denoise /src/mrtrix3/cpp/core/denoise
# General-purpose maths (MR::Math) destined for MRtrix3 core: copied file by file into the
#   existing upstream cpp/core/math/ directory, so that nothing upstream is replaced; names
#   must not collide with upstream files.
COPY cpp/core/math/noncentral_chi.h cpp/core/math/noncentral_chi.cpp /src/mrtrix3/cpp/core/math/
# Place the per-command noise estimation schedules alongside the other MRtrix3 shared data
#   files (share/mrtrix3/<command>/), so the MRtrix3 cmake build copies them into the build
#   tree (build/share/mrtrix3/) where the commands locate them relative to the executable.
COPY share/dwidenoise2 /src/mrtrix3/share/mrtrix3

# The "copy-share-data" target imports share/mrtrix3/ (including the bundled schedules) into
#   the build tree (build/share/mrtrix3/); it must be named explicitly here because building
#   named executable targets does not trigger MRtrix3's ALL custom targets.
RUN cmake -Bbuild -GNinja -DMRTRIX_BUILD_GUI=OFF -DMRTRIX_BUILD_GUI=OFF --preset=debug \
    && cmake --build build -j ${MAKE_JOBS} --target dwidenoise2 dwi2noise mrcalc mrcat mrconvert mrinfo copy-share-data

# Compile and run this module's unit tests.
#
# testing/unit_tests holds plain executables, each with its own main() and returning non-zero on a
#   failed check, together with a CMakeLists.txt that builds them. That directory is grafted in
#   alongside the MRtrix3 sources and pulled into the configuration by appending a single
#   add_subdirectory() line to the top-level CMakeLists.txt; every target it needs (mrtrix::core,
#   mrtrix::executable-version, mrtrix::common) is defined by then. Letting CMake build them, rather
#   than invoking the compiler here, is what keeps them compiled against the same Eigen, the same
#   include paths and -- decisively, for the debug preset -- the same STL debug flags as the library
#   they test.
#
# Re-running cmake on the existing build directory re-globs the sources while keeping the cached
#   settings, so the preset need not (and must not) be named again.
#
# Not part of the "final" image; build and run the tests with:
#   docker build -f Dockerfile_debug --target unit-tests -t dwidenoise2:unit-tests --build-arg MAKE_JOBS=4 .
FROM mrtrix3-builder AS unit-tests

COPY testing/unit_tests /src/mrtrix3/dwidenoise2_tests

ARG MAKE_JOBS
WORKDIR /src/mrtrix3
RUN echo 'add_subdirectory(dwidenoise2_tests)' >> CMakeLists.txt \
    && cmake -S . -B build \
    && cmake --build build -j ${MAKE_JOBS} --target dwidenoise2-unit-tests \
    && for exe in build/unit_tests/*; do \
           echo "=== $(basename "${exe}") ==="; \
           "${exe}" || exit 1; \
       done

# Build final image.
FROM base AS final

# Install runtime system dependencies.
RUN apt-get -qq update \
    && apt-get install -yq --no-install-recommends \
        gdb \
        less \
        libfftw3-single3 \
        libfftw3-double3 \
        libpng16-16 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=mrtrix3-builder /src/mrtrix3 /src/mrtrix3

# Technically not required if it's the entrypoint
ENV PATH="/src/mrtrix3/build/bin:$PATH"

ENV LD_LIBRARY_PATH="/src/mrtrix3/build/cpp/core/"

# The bundled noise estimation schedules are located relative to the executable
#   (<exe dir>/../share/mrtrix3/<command>), so no environment variable is required.

# TODO Define an entrypoint for the container
ENTRYPOINT ["gdb", "--args", "/src/mrtrix3/build/bin/dwidenoise2"]
